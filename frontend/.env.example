# Next.js server rewrite destination (origin only; the /api prefix is added by next.config.ts)
BACKEND_API_URL=http://localhost:8080

# Public website origin used to generate canonical, Open Graph, and sitemap URLs.
# Keep empty until the production domain is selected; set it on the Next.js server at deployment.
SITE_URL=

# Optional verification values. Empty values do not render verification metadata.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
