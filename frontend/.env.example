# Build-time Next.js rewrite destination (origin only; next.config.ts adds /api).
# Production ingress routes /api directly to Backend, so this rewrite is not used there.
BACKEND_API_URL=http://localhost:8080

# Public website origin used to generate canonical, Open Graph, and sitemap URLs.
# Set this before building the production image; static metadata and sitemap use the build environment.
SITE_URL=

# Optional verification values. Empty values do not render verification metadata.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
