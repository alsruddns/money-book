# Build-time Next.js rewrite destination (origin only; next.config.ts adds /api).
# Production ingress routes /api directly to Backend, so this rewrite is not used there.
BACKEND_API_URL=http://localhost:8080

# Public website origin used to generate canonical, Open Graph, JSON-LD, and sitemap URLs.
# Production defaults to https://www.woori.today; set explicitly for deployment consistency.
SITE_URL=https://www.woori.today

# Optional verification values. Empty values do not render verification metadata.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
