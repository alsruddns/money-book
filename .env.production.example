# Copy to .env.production, replace every placeholder, and keep the copy untracked.
# SITE_DOMAIN must be the public DNS name before enabling production HTTPS.
SITE_DOMAIN=www.woori.today
SITE_URL=https://www.woori.today

# Required for the Spring Boot datasource.
POSTGRES_DB=money_book
POSTGRES_USER=moneybook
POSTGRES_PASSWORD=CHANGE_ME
DB_URL=jdbc:postgresql://postgres:5432/money_book
DB_USERNAME=moneybook
DB_PASSWORD=CHANGE_ME

# Replace with at least 32 bytes of cryptographically secure random data.
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Required for production email verification. Keep real values only in the server-side .env.production file.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=noreply@example.com

# Next.js resolves rewrites at build time. Production Caddy handles /api directly.
BACKEND_API_URL=http://backend:8080

# Optional Search Console / Search Advisor verification tokens.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Optional JVM flags, for example: -XX:MaxRAMPercentage=65.0
JAVA_TOOL_OPTIONS=
